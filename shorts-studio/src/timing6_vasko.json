 "captions": [
  {
   "start": 0,
   "end": 1.34,
   "text": "Hour seventy-two."
  },
  {
   "start": 1.85,
   "end": 2.44,
   "text": "Day three."
  },
  {
   "start": 2.96,
   "end": 3.85,
   "text": "If it's winter,"
  },
  {
   "start": 4.03,
   "end": 6.12,
   "text": "your house gets colder every hour."
  },
  {
   "start": 6.41,
   "end": 9.32,
   "text": "Never use your oven or gas stove to heat your home."
  },
  {
   "start": 9.56,
   "end": 10.9,
   "text": "FEMA warns against it."
  },
  {
   "start": 11.23,
   "end": 11.78,
   "text": "Instead:"
  },
  {
   "start": 12.06,
   "end": 12.84,
   "text": "pick one room."
  },
  {
   "start": 13.09,
   "end": 14.13,
   "text": "Close off the rest."
  },
  {
   "start": 14.38,
   "end": 15.3,
   "text": "Cover the windows."
  },
  {
   "start": 15.47,
   "end": 17.58,
   "text": "Layer up, and keep everyone together."
  },
  {
   "start": 17.86,
   "end": 19.39,
   "text": "And if it gets dangerously cold,"
  },
  {
   "start": 19.61,
   "end": 22.66,
   "text": "go to a warming center, or anywhere that still has power."
  },
  {
   "start": 23.17,
   "end": 23.84,
   "text": "Next..."
  },
  {
   "start": 24.1,
   "end": 25.81,
   "text": "one full week without power."
  },
  {
   "start": 26.2,
   "end": 27.26,
   "text": "Follow for part seven."
  }
 ]
}