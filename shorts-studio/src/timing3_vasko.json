 "captions": [
  {
   "start": 0,
   "end": 1.04,
   "text": "Hour twelve."
  },
  {
   "start": 1.3,
   "end": 2.97,
   "text": "Your phone is at forty percent..."
  },
  {
   "start": 3.27,
   "end": 4.57,
   "text": "and it's dropping fast."
  },
  {
   "start": 4.98,
   "end": 5.6,
   "text": "Here's why."
  },
  {
   "start": 5.98,
   "end": 8.62,
   "text": "Your Wi-Fi router died the moment the power did."
  },
  {
   "start": 8.88,
   "end": 10.77,
   "text": "So your phone leans on the cell network."
  },
  {
   "start": 11.06,
   "end": 13.16,
   "text": "But the towers are running out of backup power."
  },
  {
   "start": 13.47,
   "end": 17.0,
   "text": "As the signal gets weaker, your phone works harder to stay connected..."
  },
  {
   "start": 17.27,
   "end": 18.53,
   "text": "and that burns battery."
  },
  {
   "start": 18.83,
   "end": 20.52,
   "text": "And everyone is calling at once."
  },
  {
   "start": 20.73,
   "end": 21.86,
   "text": "The network jams."
  },
  {
   "start": 22.23,
   "end": 23.4,
   "text": "The FCC's advice:"
  },
  {
   "start": 23.68,
   "end": 25.79,
   "text": "keep calls short, and text instead."
  },
  {
   "start": 26.04,
   "end": 28.22,
   "text": "A text can get through when a call can't."
  },
  {
   "start": 28.61,
   "end": 30.01,
   "text": "But by hour twenty-four..."
  },
  {
   "start": 30.32,
   "end": 31.75,
   "text": "the problem isn't your phone."
  },
  {
   "start": 32.11,
   "end": 32.85,
   "text": "It's your water."
  },
  {
   "start": 33.25,
   "end": 34.3,
   "text": "Follow for part four."
  }
 ]
}